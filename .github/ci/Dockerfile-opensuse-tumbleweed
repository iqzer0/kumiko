#
# Docker file for Kumiko CI tests on opensuse/tumbleweed
#
FROM opensuse/tumbleweed

# prepare
RUN mkdir -p /build/ci/

# install build dependencies
COPY install-deps-suse.sh /build/ci/
RUN chmod +x /build/ci/install-deps-suse.sh && /build/ci/install-deps-suse.sh

# install LDC from upstream tarball — uniform across all CI images
COPY install-ldc-tarball.sh /build/ci/
RUN chmod +x /build/ci/install-ldc-tarball.sh && /build/ci/install-ldc-tarball.sh

# finish
WORKDIR /build
