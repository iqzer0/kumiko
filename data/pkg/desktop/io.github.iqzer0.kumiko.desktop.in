[Desktop Entry]
Version=1.0
Name=Kumiko
Comment=A tiling terminal for Linux, forked from Tilix
Keywords=shell;prompt;command;commandline;cmd;terminal;tiling;
Exec=kumiko
Terminal=false
Type=Application
StartupNotify=true
Categories=System;TerminalEmulator;X-GNOME-Utilities;
Icon=io.github.iqzer0.kumiko
DBusActivatable=true
Actions=new-window;new-session;preferences;

[Desktop Action new-window]
Name=New Window
Exec=kumiko --action=app-new-window

[Desktop Action new-session]
Name=New Session
Exec=kumiko --action=app-new-session

[Desktop Action preferences]
Name=Preferences
Exec=kumiko --preferences
